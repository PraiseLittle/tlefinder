# Copy to `.env.local` and override values as needed for local development.

# Absolute base URL for the TLE Finder API.
# When unset, the GUI falls back to `/api/v1`, which works:
#   - in dev: Vite proxies /api -> http://127.0.0.1:2626 (see vite.config.ts)
#   - in prod: behind a same-origin reverse proxy
VITE_API_BASE_URL=http://127.0.0.1:2626/api/v1
